<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<appSettings>
		<add key="LogDestinations" value="Console,File"/>
		<add key="LogMessageTypes" value="Message,Warning,Error"/>
		<add key="LogDirectory" value="C:\Temp\Logs"/>
		<add key="LogFileName" value="LogFile"/>
	</appSettings>
</configuration>